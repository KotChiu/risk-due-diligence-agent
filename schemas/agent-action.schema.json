{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.risk-agent.local/v1/agent-action.schema.json",
  "title": "Agent Action v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ASK"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "target_risk_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_fact_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "question",
        "target_risk_ids"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "STOP"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  ]
}
